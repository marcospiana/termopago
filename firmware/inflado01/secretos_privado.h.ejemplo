/*  secretos_privado.h.ejemplo
    ----------------------------------------------------------------------------
    COPIÁ este archivo a "secretos_privado.h" y completá los valores reales.
    "secretos_privado.h" está en .gitignore -> NUNCA se commitea al repo publico.
    Este .ejemplo SÍ se commitea (solo placeholders, no hay secretos).
    ----------------------------------------------------------------------------
    Estos datos los sacás del cluster de HiveMQ Cloud (Access Management ->
    credentials) y de tu proyecto de Railway (el dominio publico del backend).
*/

#ifndef SECRETOS_PRIVADO_H
#define SECRETOS_PRIVADO_H

// ---- Broker MQTT (HiveMQ Cloud) ----
#define MQTT_HOST     "TU-CLUSTER.s1.eu.hivemq.cloud"   // host del cluster (sin puerto)
#define MQTT_PORT     8883                               // TLS
#define MQTT_USER     "TU_USUARIO_MQTT"
#define MQTT_PASS     "TU_PASSWORD_MQTT"

// ---- Backend (Railway) para el reporte de boot ----
#define BACKEND_HOST  "TU-BACKEND.up.railway.app"        // sin "https://"

#endif
